---
import { club, nav, links } from '../config';
import { url } from '../utils/url';

/** Join the club via Discord if we have it, otherwise fall back to email. */
const joinHref = links.discord || (links.email ? `mailto:${links.email}` : '');

const trim = (path: string) => path.replace(/\/$/, '');
const current = trim(Astro.url.pathname);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={url()}>
      {club.logo && <img class="header__logo" src={url(club.logo)} alt="" />}
      <span>{club.name}</span>
    </a>

    {
      nav.length > 0 && (
        <nav class="header__nav" aria-label="Main">
          {nav.map((item) => (
            <a
              href={url(item.href)}
              aria-current={trim(url(item.href)) === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    {
      joinHref && (
        <a class="button button--primary header__cta" href={joinHref}>
          Join us
        </a>
      )
    }
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-6);
    min-height: 4rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .header__brand:hover {
    color: var(--color-text);
  }

  /* The logo has its own dark background, so show it as a rounded badge. */
  .header__logo {
    width: auto;
    height: 3rem;
    border-radius: var(--radius);
  }

  .header__nav {
    display: flex;
    gap: var(--space-6);
  }

  .header__nav a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .header__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .header__cta {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  /* Narrow screens: the nav drops to its own row and scrolls sideways if it
     still doesn't fit, rather than squeezing the brand. */
  @media (max-width: 56rem) {
    .header__inner {
      padding-top: var(--space-3);
    }

    .header__nav {
      order: 3;
      width: 100%;
      gap: var(--space-6);
      padding-block: var(--space-3);
      overflow-x: auto;
      scrollbar-width: none;
    }
  }

  /* Phones: the CTA is already in the hero, so drop it from the bar, and
     tighten the nav so all four links fit on a typical phone. */
  @media (max-width: 30rem) {
    .header__cta {
      display: none;
    }

    .header__nav {
      justify-content: space-between;
      gap: var(--space-3);
    }

    .header__nav a {
      font-size: 0.8125rem;
    }
  }
</style>
