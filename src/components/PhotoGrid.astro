---
import type { Photo } from '../data/types';
import { url } from '../utils/url';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

{
  photos.length > 0 && (
    <ul class="photos" role="list">
      {photos.map((photo) => (
        <li>
          <a href={url(photo.src)}>
            <img src={url(photo.src)} alt={photo.alt} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* Same height for every photo, natural width, so portrait flyers and
     landscape photos both show in full. */
  .photos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .photos a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .photos img {
    width: auto;
    max-width: 100%;
    height: 13rem;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .photos a:hover img {
    transform: scale(1.03);
  }
</style>
