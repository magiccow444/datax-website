---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Avatar from '../components/Avatar.astro';
import EmptyState from '../components/EmptyState.astro';
import { calendar, type CalendarEvent } from '../data/events';
import { links } from '../config';
import { formatDate, dateParts, semesterOf } from '../utils/date';

const sorted = [...calendar].sort((a, b) => a.date.localeCompare(b.date));

/** Keep semesters in date order: Fall 2026 before Spring 2027. */
const semesters = new Map<string, CalendarEvent[]>();
for (const event of sorted) {
  const key = semesterOf(event.date);
  semesters.set(key, [...(semesters.get(key) ?? []), event]);
}
---

<BaseLayout
  title="Calendar"
  description="DataX General Body Meetings and socials for the 2026–2027 academic year: dates, times, locations, and guest speakers."
>
  <PageIntro eyebrow="2026–2027" title="Calendar">
    Every General Body Meeting and social this academic year. All majors and experience levels are
    welcome at every one.
    {
      links.instagram && (
        <>
          {' '}For last-minute changes, check our <a href={links.instagram}>Instagram</a>.
        </>
      )
    }
  </PageIntro>

  <section class="section section--tight">
    <div class="container">
      {
        semesters.size === 0 && (
          <EmptyState>The 2026–2027 meeting schedule will be posted here soon.</EmptyState>
        )
      }

      {
        [...semesters].map(([semester, events]) => (
          <div class="semester">
            <h2 class="section__title">{semester}</h2>
            <ol class="events" role="list">
              {events.map((event) => {
                const { month, day } = dateParts(event.date);
                return (
                  <li class="event card">
                    <div class="event__date" aria-hidden="true">
                      <span class="event__month">{month}</span>
                      <span class="event__day">{day}</span>
                    </div>

                    <div class="event__body">
                      <h3 class="event__title">{event.title}</h3>
                      <p class="event__meta">
                        <time datetime={event.date}>{formatDate(event.date)}</time> · {event.time}
                        <br />
                        {event.location}
                      </p>
                      <p class="event__description">{event.description}</p>

                      {event.speakers && event.speakers.length > 0 && (
                        <ul class="speakers" role="list">
                          {event.speakers.map((speaker) => (
                            <li class="speaker">
                              <Avatar name={speaker.name} photo={speaker.photo} />
                              <div>
                                <p class="speaker__name">
                                  {speaker.profile ? (
                                    <a href={speaker.profile}>{speaker.name}</a>
                                  ) : (
                                    speaker.name
                                  )}
                                </p>
                                {speaker.position && <p class="speaker__position">{speaker.position}</p>}
                              </div>
                            </li>
                          ))}
                        </ul>
                      )}

                      {event.photos && event.photos.length > 0 && (
                        <div class="event__photos">
                          <PhotoGrid photos={event.photos} />
                        </div>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section--tight {
    padding-block: var(--space-8);
  }

  .semester + .semester {
    margin-top: var(--space-12);
  }

  .events {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .event {
    display: flex;
    gap: var(--space-6);
  }

  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: start;
    flex-shrink: 0;
    width: 4rem;
    padding-block: var(--space-2);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius);
    line-height: 1.1;
  }

  .event__month {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .event__day {
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .event__body {
    flex: 1;
    min-width: 0;
  }

  .event__title {
    font-size: var(--text-lg);
  }

  .event__meta {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .event__description {
    margin-top: var(--space-3);
  }

  .speakers {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius);
    list-style: none;
  }

  .speaker {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .speaker__name {
    font-weight: 650;
  }

  .speaker__position {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .event__photos {
    margin-top: var(--space-4);
  }

  @media (max-width: 30rem) {
    .event {
      flex-direction: column;
      gap: var(--space-4);
    }

    .event__date {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-2);
      width: auto;
      padding: var(--space-1) var(--space-3);
    }

    .event__day {
      font-size: var(--text-lg);
    }
  }
</style>
